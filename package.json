{
  "name": "ayak-lead-collector",
  "version": "1.0.0",
  "description": "Local CLI + dashboard that collect business leads from Google Places API for Tétouan / M'diq / Martil and append them to the AYAK prospect Excel file.",
  "main": "collect.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node collect.js",
    "server": "node backend/server.js",
    "server:dev": "node -e \"process.env.PORT=process.env.PORT||'3001';require('./backend/server.js')\"",
    "frontend:dev": "npm run dev --workspace=frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:server:dev\" \"npm:frontend:dev\"",
    "build": "npm run build --workspace=frontend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
